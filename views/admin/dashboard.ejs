<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title><%= title %></title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Poppins',sans-serif;background:#030711;color:#e2e8f0;min-height:100vh}
.sidebar{position:fixed;top:0;left:0;bottom:0;width:220px;background:rgba(10,18,36,.95);border-right:1px solid rgba(139,92,246,.12);padding:28px 0;z-index:100}
.sidebar-brand{padding:0 24px 24px;border-bottom:1px solid rgba(139,92,246,.1);margin-bottom:16px}
.sidebar-brand h2{font-size:.82rem;font-weight:900;letter-spacing:2px;color:#a78bfa;line-height:1.4}
.sidebar-brand p{font-size:.62rem;color:#475569;letter-spacing:.5px;margin-top:2px}
.admin-badge{display:inline-block;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5;font-size:.58rem;font-weight:700;letter-spacing:1px;padding:2px 8px;border-radius:10px;margin-bottom:4px}
.nav-item{display:flex;align-items:center;gap:10px;padding:11px 24px;color:#64748b;text-decoration:none;font-size:.78rem;font-weight:600;transition:all .2s;letter-spacing:.3px}
.nav-item:hover{color:#a78bfa;background:rgba(124,58,237,.08)}
.nav-item.active{color:#a78bfa;background:rgba(124,58,237,.12);border-right:3px solid #7c3aed}
.nav-item i{width:18px;text-align:center}
.nav-section{padding:14px 24px 6px;font-size:.6rem;font-weight:700;color:#334155;letter-spacing:1.5px;text-transform:uppercase}
.main{margin-left:220px;padding:32px}
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}
.topbar h1{font-size:1.3rem;font-weight:800;letter-spacing:1px}
.topbar-right{display:flex;align-items:center;gap:14px;font-size:.78rem;color:#64748b}
.topbar-right strong{color:#c4b5fd}
.logout-btn{color:#475569;text-decoration:none;font-size:.72rem;padding:6px 14px;border:1px solid rgba(139,92,246,.2);border-radius:8px;transition:all .2s}
.logout-btn:hover{color:#a78bfa;border-color:#7c3aed}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:28px}
.stat-card{background:rgba(15,23,42,.8);border:1px solid rgba(139,92,246,.15);border-radius:16px;padding:22px 20px}
.stat-icon{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;margin-bottom:12px}
.stat-icon.purple{background:rgba(124,58,237,.15);border:1px solid rgba(124,58,237,.3)}
.stat-icon.green{background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.25)}
.stat-icon.red{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.25)}
.stat-icon.blue{background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.25)}
.stat-num{font-size:1.8rem;font-weight:800;background:linear-gradient(135deg,#a78bfa,#818cf8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;display:block}
.stat-lbl{font-size:.7rem;color:#64748b;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
.section-card{background:rgba(15,23,42,.8);border:1px solid rgba(139,92,246,.12);border-radius:16px;padding:24px;margin-bottom:22px}
.section-card h2{font-size:.85rem;font-weight:800;letter-spacing:1.5px;color:#a78bfa;margin-bottom:18px;text-transform:uppercase;display:flex;align-items:center;gap:8px}
table{width:100%;border-collapse:collapse}
th{text-align:left;font-size:.68rem;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.5px;padding:0 12px 10px;border-bottom:1px solid rgba(139,92,246,.1)}
td{padding:10px 12px;font-size:.78rem;color:#94a3b8;border-bottom:1px solid rgba(255,255,255,.04);vertical-align:middle}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(124,58,237,.05)}
.status-badge{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:.65rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase}
.status-active{background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.3);color:#4ade80}
.status-revoked{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5}
.pic-thumb{width:32px;height:32px;border-radius:50%;object-fit:cover;border:2px solid rgba(139,92,246,.3)}
.pic-placeholder{width:32px;height:32px;border-radius:50%;background:rgba(124,58,237,.2);display:inline-flex;align-items:center;justify-content:center;font-size:.8rem;color:#a78bfa;border:2px solid rgba(139,92,246,.3)}
.view-btn{color:#a78bfa;text-decoration:none;font-size:.72rem;font-weight:600;padding:4px 12px;border:1px solid rgba(139,92,246,.3);border-radius:6px;transition:all .2s}
.view-btn:hover{background:rgba(124,58,237,.15);border-color:#7c3aed}
@media(max-width:900px){.stats-grid{grid-template-columns:repeat(2,1fr)}.main{margin-left:0;padding:20px}}
</style>
</head>
<body>

<nav class="sidebar">
  <div class="sidebar-brand">
    <div class="admin-badge">ADMIN</div>
    <h2>IT TECH<br/>BROTHERS HUB</h2>
    <p>CONTROL PANEL</p>
  </div>
  <div class="nav-section">Navigation</div>
  <a href="/admin" class="nav-item active"><i class="fas fa-th-large"></i> Dashboard</a>
  <a href="/admin/licenses" class="nav-item"><i class="fas fa-key"></i> Licenses</a>
  <div class="nav-section">Account</div>
  <a href="/admin/logout" class="nav-item"><i class="fas fa-sign-out-alt"></i> Logout</a>
</nav>

<main class="main">
  <div class="topbar">
    <h1><i class="fas fa-th-large" style="color:#7c3aed;margin-right:10px"></i>Dashboard</h1>
    <div class="topbar-right">
      Logged in as <strong><%= admin %></strong>
      <a href="/admin/logout" class="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon purple"><i class="fas fa-key" style="color:#a78bfa"></i></div>
      <span class="stat-num"><%= stats.total_licenses || 0 %></span>
      <span class="stat-lbl">Total Licenses</span>
    </div>
    <div class="stat-card">
      <div class="stat-icon green"><i class="fas fa-check-circle" style="color:#4ade80"></i></div>
      <span class="stat-num"><%= stats.active_licenses || 0 %></span>
      <span class="stat-lbl">Active Licenses</span>
    </div>
    <div class="stat-card">
      <div class="stat-icon red"><i class="fas fa-ban" style="color:#f87171"></i></div>
      <span class="stat-num"><%= stats.revoked_licenses || 0 %></span>
      <span class="stat-lbl">Revoked Licenses</span>
    </div>
    <div class="stat-card">
      <div class="stat-icon blue"><i class="fas fa-terminal" style="color:#60a5fa"></i></div>
      <span class="stat-num"><%= stats.total_uas || 0 %></span>
      <span class="stat-lbl">UAs Generated</span>
    </div>
  </div>

  <div class="section-card">
    <h2><i class="fas fa-clock"></i> Recent Licenses</h2>
    <table>
      <thead>
        <tr>
          <th>User</th>
          <th>License Key</th>
          <th>Email</th>
          <th>Contact</th>
          <th>UAs Generated</th>
          <th>Status</th>
          <th>Registered</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (recent.length === 0) { %>
          <tr><td colspan="8" style="text-align:center;color:#334155;padding:28px">No licenses yet.</td></tr>
        <% } else { %>
          <% recent.forEach(function(l) { %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:10px">
                  <% if (l.picture_path) { %>
                    <img src="<%= l.picture_path %>" class="pic-thumb" alt=""/>
                  <% } else { %>
                    <div class="pic-placeholder"><i class="fas fa-user"></i></div>
                  <% } %>
                  <span style="color:#e2e8f0;font-weight:600"><%= l.full_name %></span>
                </div>
              </td>
              <td style="font-family:monospace;font-size:.7rem;color:#818cf8"><%= l.license_key %></td>
              <td><%= l.email %></td>
              <td><%= l.contact %></td>
              <td style="color:#a78bfa;font-weight:700"><%= l.ua_count || 0 %></td>
              <td>
                <span class="status-badge status-<%= l.status %>">
                  <%= l.status === 'active' ? '● Active' : '✕ Revoked' %>
                </span>
              </td>
              <td style="font-size:.7rem"><%= new Date(l.created_at).toLocaleDateString() %></td>
              <td><a href="/admin/license/<%= l.id %>" class="view-btn">View</a></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

</main>
</body>
</html>
