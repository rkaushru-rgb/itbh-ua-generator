<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title><%= title %></title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Poppins',sans-serif;background:#030711;color:#e2e8f0;min-height:100vh}
.sidebar{position:fixed;top:0;left:0;bottom:0;width:220px;background:rgba(10,18,36,.95);border-right:1px solid rgba(139,92,246,.12);padding:28px 0;z-index:100}
.sidebar-brand{padding:0 24px 24px;border-bottom:1px solid rgba(139,92,246,.1);margin-bottom:16px}
.sidebar-brand h2{font-size:.82rem;font-weight:900;letter-spacing:2px;color:#a78bfa;line-height:1.4}
.sidebar-brand p{font-size:.62rem;color:#475569;letter-spacing:.5px;margin-top:2px}
.admin-badge{display:inline-block;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5;font-size:.58rem;font-weight:700;letter-spacing:1px;padding:2px 8px;border-radius:10px;margin-bottom:4px}
.nav-item{display:flex;align-items:center;gap:10px;padding:11px 24px;color:#64748b;text-decoration:none;font-size:.78rem;font-weight:600;transition:all .2s}
.nav-item:hover{color:#a78bfa;background:rgba(124,58,237,.08)}
.nav-item.active{color:#a78bfa;background:rgba(124,58,237,.12);border-right:3px solid #7c3aed}
.nav-item i{width:18px;text-align:center}
.nav-section{padding:14px 24px 6px;font-size:.6rem;font-weight:700;color:#334155;letter-spacing:1.5px;text-transform:uppercase}
.main{margin-left:220px;padding:32px}
.topbar{display:flex;align-items:center;gap:14px;margin-bottom:28px}
.topbar h1{font-size:1.2rem;font-weight:800;letter-spacing:1px}
.back-btn{color:#64748b;text-decoration:none;font-size:.78rem;padding:7px 14px;border:1px solid rgba(139,92,246,.2);border-radius:8px;transition:all .2s;display:flex;align-items:center;gap:6px}
.back-btn:hover{color:#a78bfa;border-color:#7c3aed}
.grid-2{display:grid;grid-template-columns:340px 1fr;gap:22px;margin-bottom:22px;align-items:start}
.section-card{background:rgba(15,23,42,.8);border:1px solid rgba(139,92,246,.12);border-radius:16px;padding:24px;margin-bottom:22px}
.section-card h2{font-size:.82rem;font-weight:800;letter-spacing:1.5px;color:#a78bfa;margin-bottom:18px;text-transform:uppercase;display:flex;align-items:center;gap:8px}
.profile-pic{width:120px;height:120px;border-radius:16px;object-fit:cover;border:3px solid rgba(139,92,246,.4);display:block;margin:0 auto 18px}
.profile-placeholder{width:120px;height:120px;border-radius:16px;background:rgba(124,58,237,.15);border:3px solid rgba(139,92,246,.3);display:flex;align-items:center;justify-content:center;font-size:3rem;color:#a78bfa;margin:0 auto 18px}
.info-row{display:flex;align-items:flex-start;gap:10px;margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid rgba(255,255,255,.04)}
.info-row:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0}
.info-label{font-size:.65rem;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.5px;width:110px;flex-shrink:0;padding-top:2px}
.info-value{font-size:.8rem;color:#e2e8f0;font-weight:500;word-break:break-all}
.info-value.mono{font-family:monospace;font-size:.72rem;color:#818cf8}
.info-value.key{font-family:monospace;font-size:.82rem;color:#a78bfa;letter-spacing:1.5px;font-weight:700}
.status-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:20px;font-size:.7rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase}
.status-active{background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.3);color:#4ade80}
.status-revoked{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5}
.action-btns{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.btn{padding:9px 20px;border:none;border-radius:10px;font-family:'Poppins',sans-serif;font-weight:700;font-size:.78rem;cursor:pointer;letter-spacing:.5px;text-transform:uppercase;transition:all .2s}
.btn-activate{background:rgba(34,197,94,.15);border:1px solid rgba(34,197,94,.3);color:#4ade80}
.btn-activate:hover{background:rgba(34,197,94,.25)}
.btn-revoke{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5}
.btn-revoke:hover{background:rgba(239,68,68,.2)}
.btn-delete{background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);color:#f87171}
.btn-delete:hover{background:rgba(239,68,68,.18)}
.btn-notes{background:linear-gradient(135deg,#7c3aed,#4f46e5);color:#fff}
.btn-notes:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(124,58,237,.4)}
.notes-textarea{width:100%;padding:12px;background:#0a1224;border:1.5px solid rgba(139,92,246,.25);border-radius:10px;color:#e2e8f0;font-size:.8rem;font-family:'Poppins',sans-serif;outline:none;resize:vertical;min-height:80px;transition:border-color .2s;margin-bottom:10px}
.notes-textarea:focus{border-color:#7c3aed}
table{width:100%;border-collapse:collapse}
th{text-align:left;font-size:.65rem;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.5px;padding:0 12px 10px;border-bottom:1px solid rgba(139,92,246,.1);white-space:nowrap}
td{padding:9px 12px;font-size:.74rem;color:#94a3b8;border-bottom:1px solid rgba(255,255,255,.04);vertical-align:middle}
tr:last-child td{border-bottom:none}
.ua-cell{font-family:monospace;font-size:.65rem;color:#a5f3fc;max-width:380px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media(max-width:900px){.grid-2{grid-template-columns:1fr}.main{margin-left:0;padding:20px}}
</style>
</head>
<body>

<nav class="sidebar">
  <div class="sidebar-brand">
    <div class="admin-badge">ADMIN</div>
    <h2>IT TECH<br/>BROTHERS HUB</h2>
    <p>CONTROL PANEL</p>
  </div>
  <div class="nav-section">Navigation</div>
  <a href="/admin" class="nav-item"><i class="fas fa-th-large"></i> Dashboard</a>
  <a href="/admin/licenses" class="nav-item active"><i class="fas fa-key"></i> Licenses</a>
  <div class="nav-section">Account</div>
  <a href="/admin/logout" class="nav-item"><i class="fas fa-sign-out-alt"></i> Logout</a>
</nav>

<main class="main">
  <div class="topbar">
    <a href="/admin/licenses" class="back-btn"><i class="fas fa-arrow-left"></i> Back</a>
    <h1><i class="fas fa-id-card" style="color:#7c3aed;margin-right:8px"></i>License Detail</h1>
  </div>

  <div class="grid-2">
    <div class="section-card">
      <h2><i class="fas fa-user"></i> License Holder</h2>
      <% if (license.picture_path) { %>
        <img src="<%= license.picture_path %>" class="profile-pic" alt="Profile Picture"/>
      <% } else { %>
        <div class="profile-placeholder"><i class="fas fa-user"></i></div>
      <% } %>

      <div class="info-row">
        <span class="info-label">Full Name</span>
        <span class="info-value" style="color:#e2e8f0;font-weight:700"><%= license.full_name %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Email</span>
        <span class="info-value"><%= license.email %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Contact</span>
        <span class="info-value"><%= license.contact %></span>
      </div>
      <div class="info-row">
        <span class="info-label">License Key</span>
        <span class="info-value key"><%= license.license_key %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Status</span>
        <span class="status-badge status-<%= license.status %>">
          <%= license.status === 'active' ? '● Active' : '✕ Revoked' %>
        </span>
      </div>
      <div class="info-row">
        <span class="info-label">UAs Generated</span>
        <span class="info-value" style="color:#a78bfa;font-weight:700"><%= license.ua_count || 0 %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Registered</span>
        <span class="info-value"><%= new Date(license.created_at).toLocaleString() %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Last Login</span>
        <span class="info-value"><%= license.last_login ? new Date(license.last_login).toLocaleString() : '—' %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Hardware ID</span>
        <span class="info-value mono" style="font-size:.62rem"><%= license.hardware_id %></span>
      </div>
      <% if (license.last_device) { %>
        <div class="info-row">
          <span class="info-label">Last Device UA</span>
          <span class="info-value mono" style="font-size:.62rem;color:#64748b"><%= license.last_device.substring(0,100) %>...</span>
        </div>
      <% } %>
    </div>

    <div>
      <div class="section-card">
        <h2><i class="fas fa-cogs"></i> Actions</h2>
        <% if (license.status === 'revoked') { %>
          <form method="POST" action="/admin/license/<%= license.id %>/status" style="display:inline">
            <input type="hidden" name="status" value="active"/>
            <button type="submit" class="btn btn-activate"><i class="fas fa-check"></i> Activate License</button>
          </form>
        <% } else { %>
          <form method="POST" action="/admin/license/<%= license.id %>/status" style="display:inline">
            <input type="hidden" name="status" value="revoked"/>
            <button type="submit" class="btn btn-revoke" onclick="return confirm('Revoke this license?')">
              <i class="fas fa-ban"></i> Revoke License
            </button>
          </form>
        <% } %>
        &nbsp;
        <form method="POST" action="/admin/license/<%= license.id %>/delete" style="display:inline">
          <button type="submit" class="btn btn-delete" onclick="return confirm('PERMANENTLY DELETE this license and all its data? This cannot be undone.')">
            <i class="fas fa-trash"></i> Delete
          </button>
        </form>
      </div>

      <div class="section-card">
        <h2><i class="fas fa-sticky-note"></i> Admin Notes</h2>
        <form method="POST" action="/admin/license/<%= license.id %>/notes">
          <textarea class="notes-textarea" name="notes" placeholder="Add internal notes about this license holder..."><%= license.notes || '' %></textarea>
          <button type="submit" class="btn btn-notes"><i class="fas fa-save"></i> Save Notes</button>
        </form>
      </div>
    </div>
  </div>

  <div class="section-card">
    <h2><i class="fas fa-terminal"></i> Generated User Agents (<%= uas.length %> most recent)</h2>
    <% if (uas.length === 0) { %>
      <p style="color:#334155;font-size:.8rem;text-align:center;padding:20px">No user agents generated yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>User Agent String</th>
            <th>Device</th>
            <th>OS</th>
            <th>Browser</th>
            <th>Generated</th>
          </tr>
        </thead>
        <tbody>
          <% uas.forEach(function(ua) { %>
            <tr>
              <td class="ua-cell" title="<%= ua.ua_string %>"><%= ua.ua_string %></td>
              <td><%= ua.device_type %></td>
              <td><%= ua.os_name %> <%= ua.os_version %></td>
              <td><%= ua.browser_name %> <%= ua.browser_version %></td>
              <td style="font-size:.68rem;white-space:nowrap"><%= new Date(ua.generated_at).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</main>
</body>
</html>
